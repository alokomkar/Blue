{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/director.ts": { "maxDuration": 60, "memory": 1024 },
    "api/ai/scan.ts": { "maxDuration": 60, "memory": 1024 },
    "api/ai/story.ts": { "maxDuration": 60, "memory": 1024 },
    "api/ai/transcribe.ts": { "maxDuration": 30, "memory": 512 },
    "api/ai/ping.ts": { "maxDuration": 10, "memory": 256 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
