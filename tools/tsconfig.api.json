{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM is here because the server imports the game's generators from src/client (api/_lib/generators.ts); they are
    // pure at run time, but their imports pull the rest of the client into the type graph, and it uses the DOM types.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // Checked on its own, not built as a composite project (a composite one must list every file it imports).
    "composite": false,
    "noEmit": true,
    "rootDir": "..",
    "allowImportingTsExtensions": true
  },
  "include": ["../api/**/*"]
}
