# Copy to .env for local runs (git-ignored). On Vercel set the same names in Project Settings -> Environment Variables.

# Required for any model call. Server-side only: never prefix with VITE_, never put it in the client.
MODEL_API_KEY=

# Model names (optional; defaults: muse-spark-1.3, muse-spark-1.3, muse-image-1.0, muse-voice-transcribe-1.0, sam-3.1).
MODEL_TEXT=
MODEL_PLANNER=
MODEL_IMAGE=
MODEL_ASR=
MODEL_SAM=

# Open-weight run: point the same OpenAI-compatible client at another host and model.
LLM_BASE_URL=
LLM_MODEL=

# Local only: the port scripts/dev-api.mjs listens on (and vite proxies /api/ai to).
API_PORT=
